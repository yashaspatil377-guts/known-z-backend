# Razorpay — from dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key_here

# Resend — from resend.com (free) -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# The email address that should receive order notifications
NOTIFY_EMAIL=knownz.co@gmail.com

# A password YOU make up — protects your order management page.
# Pick something only you know, doesn't need to be fancy.
ADMIN_PASSWORD=choose-your-own-password

# KV_REST_API_URL, KV_REST_API_TOKEN, etc. — these get added automatically
# when you connect a Vercel KV database to this project. Don't set them by hand.
